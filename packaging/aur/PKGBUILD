pkgname=autokeypresser
pkgver=1.5
pkgrel=1
pkgdesc='Cross-platform keyboard and mouse auto presser'
arch=('x86_64')
url='https://github.com/CamjamPNG/autokeypresser'
license=('MIT')
depends=('python' 'python-pyautogui' 'python-pynput' 'tk')
source=("$pkgname-$pkgver.tar.gz::https://github.com/CamjamPNG/autokeypresser/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/autokeypresser-$pkgver"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -d "$pkgdir/usr/share/$pkgname"
  cp -r main.py autoclicker "$pkgdir/usr/share/$pkgname/"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<EOF
#!/bin/sh
exec python /usr/share/$pkgname/main.py "\$@"
EOF
}
